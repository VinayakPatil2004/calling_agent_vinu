"""
CityLinc Conversation Context Engine.
Tracks multi-turn conversational session state, user intent, resolved origins/destinations,
selected routes, timetable results, and handles natural follow-up queries.

Features:
- Session-isolated structured memory: origin, destination, selected route, boarding/alighting stops.
- Follow-up query resolution: 'next bus', 'fare', 'stops list', 'timing' without re-asking origin/destination.
- Topic transition detection: cleanly resets context when a completely new route or topic is requested.
- Graceful conversation lifecycle: recognizes explicit termination phrases ('Goodbye', 'मला आता मदत नको', 'बाय', 'अलविदा') while keeping session open on polite acknowledgments like 'Thank you' / 'धन्यवाद'.
"""
import re
import time
import logging
from typing import Dict, List, Optional, Any, Tuple
from pydantic import BaseModel, Field

from backend.app.services.route_engine import route_engine, JourneySearchResult, DirectRouteOption
from backend.app.services.timetable_engine import timetable_engine, TimetableResponse
from backend.app.services.location_service import location_service
from backend.app.services.citylinc_knowledge import knowledge_service, LOCATION_ALIASES, DEVANAGARI_DIGITS

logger = logging.getLogger("citylinc.context")

# Explicit conversation termination phrases
TERMINATION_PATTERNS = [
    r'\b(?:goodbye|bye|bye\s*bye|see\s*you|exit|quit|stop)\b',
    r'\b(?:बाय|बाय\s*बाय|अलविदा|टाटा|थोड्या वेळाने बोलू)\b',
    r'मला\s*(?:आता|सध्या)?\s*(?:मदत|काही)?\s*नको',
    r'आता\s*नको',
    r'बस\s*आता\s*काही\s*नको',
    r'मुझे\s*(?:अब|और)?\s*मदद\s*नहीं\s*चाहिए',
    r'बस\s*इतना\s*ही'
]

# Polite acknowledgement phrases (MUST NOT terminate session)
POLITE_THANKS_PATTERNS = [
    r'\b(?:thank\s*you|thanks|thankyou|thx)\b',
    r'\b(?:धन्यवाद|आभार|थँक्यू|थॅंक\s*यु|शुक्रिया|मेहरबानी)\b'
]


class SessionTransitContext(BaseModel):
    session_id: str
    language: str = "mr-IN"
    origin: Optional[str] = None
    destination: Optional[str] = None
    origin_display: Optional[str] = None
    destination_display: Optional[str] = None
    selected_route_id: Optional[int] = None
    selected_rno: Optional[str] = None
    selected_route_name: Optional[str] = None
    boarding_stop_id: Optional[int] = None
    boarding_stop_name: Optional[str] = None
    alighting_stop_id: Optional[int] = None
    alighting_stop_name: Optional[str] = None
    last_direct_routes: List[Dict[str, Any]] = []
    last_transfer_routes: List[Dict[str, Any]] = []
    last_fare_estimate: Optional[Dict[str, Any]] = None
    last_timetable_response: Optional[Dict[str, Any]] = None
    last_intent: str = "general"
    pending_clarification: Optional[str] = None
    is_terminated: bool = False
    turn_count: int = 0
    created_at: float = Field(default_factory=time.time)
    last_active: float = Field(default_factory=time.time)


class ContextEngine:
    """Manages multi-turn transit dialog context across active sessions."""

    def __init__(self):
        self.sessions: Dict[str, SessionTransitContext] = {}

    def get_or_create_context(self, session_id: str, language: str = "mr-IN") -> SessionTransitContext:
        """Retrieves or creates context state for a session."""
        if session_id not in self.sessions:
            self.sessions[session_id] = SessionTransitContext(session_id=session_id, language=language)
            logger.info(f"Initialized new transit context for session: {session_id}")
        ctx = self.sessions[session_id]
        ctx.last_active = time.time()
        if language and language in ("mr-IN", "hi-IN", "en-IN"):
            ctx.language = language
        return ctx

    def clear_context(self, session_id: str):
        """Cleans up session context upon connection close."""
        if session_id in self.sessions:
            del self.sessions[session_id]

    def check_termination(self, text: str) -> bool:
        """Checks if user explicitly requested to end the conversation."""
        norm = text.lower().strip()
        return any(re.search(pat, norm, re.IGNORECASE) for pat in TERMINATION_PATTERNS)

    def check_polite_thanks(self, text: str) -> bool:
        """Checks if user expressed polite thanks without ending conversation."""
        norm = text.lower().strip()
        # If it has explicit termination, treat as termination
        if self.check_termination(text):
            return False
        return any(re.search(pat, norm, re.IGNORECASE) for pat in POLITE_THANKS_PATTERNS)

    def detect_intent(self, text: str, ctx: SessionTransitContext) -> str:
        """
        Classifies incoming user intent into:
        - 'termination': user explicitly requested to end
        - 'thanks': user thanked assistant
        - 'greeting': greetings
        - 'route_search': origin to destination pathfinding
        - 'next_bus': next bus query
        - 'timetable': timetable / departures query
        - 'fare': ticket price / pass query
        - 'hospital': hospital search / navigation query
        - 'stops': query about stops of a route
        - 'general': general query
        """
        norm = text.lower().strip()
        for d_char, a_digit in DEVANAGARI_DIGITS.items():
            norm = norm.replace(d_char, a_digit)

        # 1. Termination
        if self.check_termination(norm):
            return "termination"

        # 2. Polite thanks
        if self.check_polite_thanks(norm):
            return "thanks"

        # 3. Hospital
        if any(w in norm for w in [
            "hospital", "रुग्णालय", "दवाखाना", "हॉस्पिटल", "clinic", "सिव्हिल", "civil", "esi", "बायको", "bytco", "namco", "नामको", "अपोलो", "apollo"
        ]):
            return "hospital"

        # 4. Next Bus
        if any(w in norm for w in [
            "next bus", "पुढची बस", "पुढील बस", "अगली बस", "next", "किती वाजता", "कधी आहे", "कब है", "when is the next", "टाइम काय", "timing"
        ]):
            return "next_bus"

        # 5. Timetable / Schedule
        if any(w in norm for w in [
            "वेळापत्रक", "वेळ", "टाइमटेबल", "timetable", "schedule", "पहिली बस", "शेवटची बस", "सकाळची बस", "संध्याकाळची बस", "first bus", "last bus"
        ]):
            return "timetable"

        # 6. Fare
        if any(w in norm for w in [
            "भाडं", "भाडे", "तिकीट", "तिकिट", "किराया", "टिकट", "fare", "ticket", "cost", "price", "pass", "पास"
        ]):
            return "fare"

        # 7. Stops of a route
        if any(w in norm for w in ["थांबे", "थांबा", "स्टॉप", "stops", "stop"]):
            return "stops"

        # 8. Greetings (using word boundaries to avoid matching 'hi' in 'panchavati')
        if any(re.search(rf'\b{re.escape(w)}\b', norm, re.IGNORECASE) for w in ["hello", "hi", "namaste", "नमस्कार", "नमस्ते", "का हाल"]):
            return "greeting"

        # 9. Route search (detect origin-to-destination pattern)
        if any(w in norm for w in ["वरून", "ते", "पासुन", "पासून", "हून", "ला जायचं", "ला जायचे", "to", "from", "से", "तक"]):
            return "route_search"

        # If origin/destination or routes mention places
        for a in LOCATION_ALIASES:
            if a in norm:
                return "route_search"

        return "general"

    def process_turn(
        self,
        session_id: str,
        user_text: str,
        language: str = "mr-IN"
    ) -> Dict[str, Any]:
        """
        Processes a conversation turn deterministically using structured session context.
        Returns:
        {
            "handled_deterministically": bool,
            "response_text": str,
            "intent": str,
            "map_action": Optional[Dict[str, Any]],
            "is_terminated": bool
        }
        """
        ctx = self.get_or_create_context(session_id, language=language)
        ctx.turn_count += 1
        intent = self.detect_intent(user_text, ctx)
        ctx.last_intent = intent
        lang = ctx.language

        # -------------------------------------------------------------
        # 1. Termination Intent
        # -------------------------------------------------------------
        if intent == "termination":
            ctx.is_terminated = True
            msg = {
                "mr-IN": "सिटीलिंक नाशिक बस सेवेचा वापर केल्याबद्दल धन्यवाद! आपला प्रवास सुखकर होवो. बाय!",
                "hi-IN": "सिटीलिंक नाशिक बस सेवा का उपयोग करने के लिए धन्यवाद! आपकी यात्रा मंगलमय हो। अलविदा!",
                "en-IN": "Thank you for using CityLinc Nashik bus assistant! Have a safe and pleasant journey. Goodbye!"
            }.get(lang, "Goodbye!")
            return {
                "handled_deterministically": True,
                "response_text": msg,
                "intent": "termination",
                "map_action": None,
                "is_terminated": True
            }

        # -------------------------------------------------------------
        # 2. Polite Thanks (Keeps session alive)
        # -------------------------------------------------------------
        if intent == "thanks":
            msg = {
                "mr-IN": "काही हरकत नाही! मी तुम्हाला मार्ग, वेळापत्रक किंवा बस पासबद्दल आणखी काही मदत करू का?",
                "hi-IN": "आपका स्वागत है! क्या आपको रूट, समय-सारणी या बस पास के बारे में कोई और सहायता चाहिए?",
                "en-IN": "You are welcome! Can I help you with any other routes, timetables, or bus passes?"
            }.get(lang, "You're welcome!")
            return {
                "handled_deterministically": True,
                "response_text": msg,
                "intent": "thanks",
                "map_action": None,
                "is_terminated": False
            }

        # -------------------------------------------------------------
        # 3. Greeting Intent
        # -------------------------------------------------------------
        if intent == "greeting":
            msg = {
                "mr-IN": "नमस्कार! मी सिटीलिंक नाशिक बस सहाय्यक आहे. मी तुम्हाला नाशिकमधील ३१५ बस मार्ग, वेळापत्रक आणि पासबद्दल कशी मदत करू?",
                "hi-IN": "नमस्ते! मैं सिटीलिंक नाशिक बस सहायक हूँ। मैं आपको नाशिक के 315 बस रूट, समय-सारणी और पास की जानकारी में कैसे मदद करूँ?",
                "en-IN": "Hello! I am the CityLinc Nashik bus assistant. How can I assist you across our 315 routes, timetables, or bus passes today?"
            }.get(lang, "Hello! How can I assist you with CityLinc buses today?")
            return {
                "handled_deterministically": True,
                "response_text": msg,
                "intent": "greeting",
                "map_action": None,
                "is_terminated": False
            }

        # -------------------------------------------------------------
        # 4. Next Bus Query (Follow-up using Context)
        # -------------------------------------------------------------
        if intent == "next_bus":
            # Check if we have context of route or origin-destination
            if ctx.selected_rno or ctx.selected_route_id:
                target_r = str(ctx.selected_route_id or ctx.selected_rno)
                b_name = ctx.boarding_stop_name
                tt_res = timetable_engine.query_route_departures(
                    target_r,
                    boarding_stop_id=ctx.boarding_stop_id,
                    boarding_stop_name=b_name,
                    query_mode="next"
                )
                ctx.last_timetable_response = tt_res.model_dump()
                reply = {
                    "mr-IN": tt_res.message_mr,
                    "hi-IN": tt_res.message_hi,
                    "en-IN": tt_res.message_en
                }.get(lang, tt_res.message_en)
                return {
                    "handled_deterministically": True,
                    "response_text": reply,
                    "intent": "next_bus",
                    "map_action": None,
                    "is_terminated": False
                }

            if ctx.origin and ctx.destination:
                tt_res = timetable_engine.get_next_bus_for_od(ctx.origin, ctx.destination)
                ctx.last_timetable_response = tt_res.model_dump()
                reply = {
                    "mr-IN": tt_res.message_mr,
                    "hi-IN": tt_res.message_hi,
                    "en-IN": tt_res.message_en
                }.get(lang, tt_res.message_en)
                return {
                    "handled_deterministically": True,
                    "response_text": reply,
                    "intent": "next_bus",
                    "map_action": None,
                    "is_terminated": False
                }

            # If no context exists, ask user for route or origin-destination
            ask_msg = {
                "mr-IN": "तुम्हाला कोणत्या मार्गाची किंवा कुठून कुठे जाणाऱ्या बसची वेळ जाणून घ्यायची आहे? कृपया सांगा.",
                "hi-IN": "आप किस रूट या कहाँ से कहाँ तक की बस का समय जानना चाहते हैं? कृपया बताएं।",
                "en-IN": "Which route or origin-destination would you like the next bus timing for? Please let me know."
            }.get(lang, "Please specify the route or origin and destination.")
            return {
                "handled_deterministically": True,
                "response_text": ask_msg,
                "intent": "next_bus",
                "map_action": None,
                "is_terminated": False
            }

        # -------------------------------------------------------------
        # 5. Fare Query (Follow-up using Context)
        # -------------------------------------------------------------
        if intent == "fare":
            if ctx.last_fare_estimate and ctx.origin_display and ctx.destination_display:
                fare = ctx.last_fare_estimate.get("single_fare_inr", 20)
                dist = ctx.last_fare_estimate.get("distance_km", 10.0)
                msg = {
                    "mr-IN": f"{ctx.origin_display} ते {ctx.destination_display} ({dist} किमी) प्रवासासाठी एका व्यक्तीचे तिकीट भाडे ₹{fare} आहे. (मासिक पासवर ५०% सवलत उपलब्ध).",
                    "hi-IN": f"{ctx.origin_display} से {ctx.destination_display} ({dist} किमी) की यात्रा के लिए एक व्यक्ति का किराया ₹{fare} है। (मासिक पास पर 50% छूट उपलब्ध है)।",
                    "en-IN": f"The single one-way adult fare between {ctx.origin_display} and {ctx.destination_display} ({dist} km) is ₹{fare}. (Monthly pass discount available)."
                }.get(lang, f"The fare is ₹{fare}.")
                return {
                    "handled_deterministically": True,
                    "response_text": msg,
                    "intent": "fare",
                    "map_action": None,
                    "is_terminated": False
                }

            # Check if user asked about general bus pass rates
            if any(w in user_text.lower() for w in ["pass", "पास"]):
                msg = {
                    "mr-IN": "सिटीलिंक बस पास: अमर्यादित मासिक पास ₹२,१००, त्रैमासिक पास (९० दिवस) ₹५,२५०, आणि अर्धवार्षिक पास (१८० दिवस) ₹९,४५०. विद्यार्थ्यांना मासिक पासवर ५०% सवलत मिळते.",
                    "hi-IN": "सिटीलिंक बस पास: अनलिमिटेड मासिक पास ₹2,100, त्रैमासिक पास (90 दिन) ₹5,250, और छह महीने का पास ₹9,450 है। छात्रों को 50% छूट मिलती है।",
                    "en-IN": "CityLinc All-Route Bus Passes: 30-Day pass is ₹2,100, 90-Day pass is ₹5,250, and 180-Day pass is ₹9,450. Students receive 50% concession."
                }.get(lang, "Bus pass options available.")
                return {
                    "handled_deterministically": True,
                    "response_text": msg,
                    "intent": "fare",
                    "map_action": None,
                    "is_terminated": False
                }

        # -------------------------------------------------------------
        # 6. Hospital Navigation Query
        # -------------------------------------------------------------
        if intent == "hospital":
            nav_res = location_service.get_hospital_navigation(user_text)
            if nav_res.get("resolved"):
                h_name = nav_res["name_mr"] if lang == "mr-IN" else nav_res["name_en"]
                p_stop = nav_res.get("primary_alighting_stop", {})
                stop_name = p_stop.get("name", "जवळच्या थांब्यावर")
                walk_m = p_stop.get("approx_walk_distance_m", 50)
                routes_sample = ", ".join(nav_res.get("direct_routes", [])[:6])

                msg = {
                    "mr-IN": f"{h_name} ला जाण्यासाठी तुम्ही '{stop_name}' थांब्यावर उतरावे (रुग्णालयाच्या मुख्य प्रवेशद्वारापासून अंदाजे {walk_m} मीटर चालणे). या थांब्यावरून धावणाऱ्या प्रमुख बसेस: {routes_sample}.",
                    "hi-IN": f"{h_name} जाने के लिए आप '{stop_name}' स्टॉप पर उतरें (अस्पताल के मुख्य गेट से लगभग {walk_m} मीटर पैदल)। मुख्य बसें: {routes_sample}।",
                    "en-IN": f"To reach {nav_res['name_en']}, alight at '{stop_name}' (approx. {walk_m}m walk to hospital main entrance). Passing routes: {routes_sample}."
                }.get(lang, f"Alight at {stop_name}.")

                # Map action to highlight hospital
                map_action = {
                    "action": "highlight_hospital",
                    "hospital_id": nav_res["hospital_id"],
                    "hospital_name": nav_res["name_en"],
                    "physical_coordinates": nav_res["physical_coordinates"],
                    "primary_stop": p_stop,
                    "linked_stops": nav_res.get("linked_stops", [])
                }
                return {
                    "handled_deterministically": True,
                    "response_text": msg,
                    "intent": "hospital",
                    "map_action": map_action,
                    "is_terminated": False
                }

        # -------------------------------------------------------------
        # 7. Origin-Destination Route Search
        # -------------------------------------------------------------
        # Check if text contains origin and destination
        parsed_od = self._extract_origin_destination(user_text)
        if parsed_od:
            orig_raw, dest_raw = parsed_od
            search_res = route_engine.search_routes(orig_raw, dest_raw, limit_direct=3)

            if search_res.success and search_res.direct_routes:
                top_r = search_res.direct_routes[0]
                # Update Context
                ctx.origin = orig_raw
                ctx.destination = dest_raw
                ctx.origin_display = search_res.origin.display_name
                ctx.destination_display = search_res.destination.display_name
                ctx.selected_route_id = top_r.route_id
                ctx.selected_rno = top_r.rno
                ctx.selected_route_name = top_r.route_name
                ctx.boarding_stop_id = top_r.boarding_stop.station_id
                ctx.boarding_stop_name = top_r.boarding_stop.name
                ctx.alighting_stop_id = top_r.alighting_stop.station_id
                ctx.alighting_stop_name = top_r.alighting_stop.name
                ctx.last_direct_routes = [r.model_dump() for r in search_res.direct_routes]
                ctx.last_fare_estimate = search_res.fare_estimate

                rnos_list = ", ".join([r.rno for r in search_res.direct_routes])
                b_stop = top_r.boarding_stop.name
                a_stop = top_r.alighting_stop.name
                n_stops = top_r.intermediate_stops_count
                dist = top_r.distance_km
                fare = search_res.fare_estimate.get("single_fare_inr", 20) if search_res.fare_estimate else 20

                msg = {
                    "mr-IN": f"{ctx.origin_display} ते {ctx.destination_display} साठी थेट बस मार्ग: {rnos_list}. प्रमुख मार्ग {top_r.rno} ({top_r.route_name}) ने '{b_stop}' वरून चढावे आणि '{a_stop}' वर उतरावे ({n_stops} थांबे, {dist} किमी, भाडे ₹{fare}).",
                    "hi-IN": f"{ctx.origin_display} से {ctx.destination_display} के लिए सीधी बसें: {rnos_list}। मुख्य रूट {top_r.rno} ({top_r.route_name}) से '{b_stop}' से बैठें और '{a_stop}' पर उतरें ({n_stops} स्टॉप, {dist} किमी, किराया ₹{fare})।",
                    "en-IN": f"Direct CityLinc routes between {ctx.origin_display} and {ctx.destination_display}: Routes {rnos_list}. Take Route {top_r.rno} ({top_r.route_name}) boarding at '{b_stop}' and alighting at '{a_stop}' ({n_stops} stops, {dist} km, fare ₹{fare})."
                }.get(lang, f"Take Route {top_r.rno} from {b_stop} to {a_stop}.")

                # Map action
                map_action = {
                    "action": "highlight_journey",
                    "route_id": top_r.route_id,
                    "rno": top_r.rno,
                    "route_name": top_r.route_name,
                    "origin": {
                        "name": top_r.boarding_stop.name,
                        "lat": top_r.boarding_stop.lat,
                        "lon": top_r.boarding_stop.lon
                    },
                    "destination": {
                        "name": top_r.alighting_stop.name,
                        "lat": top_r.alighting_stop.lat,
                        "lon": top_r.alighting_stop.lon
                    },
                    "boarding_stop": top_r.boarding_stop.model_dump(),
                    "alighting_stop": top_r.alighting_stop.model_dump(),
                    "intermediate_stops": [s.model_dump() for s in top_r.intermediate_stops],
                    "polyline": top_r.polyline
                }

                return {
                    "handled_deterministically": True,
                    "response_text": msg,
                    "intent": "route_search",
                    "map_action": map_action,
                    "is_terminated": False
                }

            elif search_res.success and search_res.transfer_routes:
                tr = search_res.transfer_routes[0]
                msg = {
                    "mr-IN": f"{search_res.origin.display_name} ते {search_res.destination.display_name} थेट बस नाही. तुम्ही {tr.interchange_hub_mr} येथे बस बदलू शकता: प्रथम मार्ग {tr.leg1.rno} ने '{tr.transfer_stop_name}' ला जा, व तेथून मार्ग {tr.leg2.rno} ने '{tr.leg2.alighting_stop.name}' ला पोहोचा.",
                    "hi-IN": f"{search_res.origin.display_name} से {search_res.destination.display_name} के लिए सीधी बस नहीं है। आप {tr.interchange_hub} पर बस बदल सकते हैं: पहले रूट {tr.leg1.rno} से '{tr.transfer_stop_name}' जाएं, फिर रूट {tr.leg2.rno} लें।",
                    "en-IN": f"No direct route between {search_res.origin.display_name} and {search_res.destination.display_name}. Transfer at {tr.interchange_hub}: take Route {tr.leg1.rno} to '{tr.transfer_stop_name}', then transfer to Route {tr.leg2.rno}."
                }.get(lang, "Transfer route available.")

                return {
                    "handled_deterministically": True,
                    "response_text": msg,
                    "intent": "route_search",
                    "map_action": None,
                    "is_terminated": False
                }

        return {
            "handled_deterministically": False,
            "response_text": "",
            "intent": intent,
            "map_action": None,
            "is_terminated": False
        }

    def _clean_token(self, t: str) -> str:
        val = t.strip()
        # Strip conversational starters
        for prefix in [
            "मला ", "आम्हाला ", "कृपया ", "मला कृपया ", "मला आता ", "मला तर ", "मला फक्त ", "मला जरा ",
            "मुझे ", "कृपया ", "please ", "can you tell me ", "i want to go from ", "how to go from "
        ]:
            if val.lower().startswith(prefix):
                val = val[len(prefix):].strip()

        # Strip conversational trailers
        for suffix in [
            " जायचं आहे", " जायचे आहे", " जायचं", " जायचे", " जाणे आहे", " जाना है", " जाना", " पर्यंत", " ला",
            " to go", " want to reach"
        ]:
            if val.endswith(suffix):
                val = val[:-len(suffix)].strip()
        return val.strip()

    def _extract_origin_destination(self, text: str) -> Optional[Tuple[str, str]]:
        """Extracts origin and destination place tokens from natural language input."""
        norm = text.strip()

        # Pattern 1: Marathi "X वरून Y ला / कडे / पर्यंत"
        m_mr = re.search(r'([a-zA-Z\u0900-\u097F\s]+?)\s*(?:वरून|पासुन|पासून|हून|कडून)\s+([a-zA-Z\u0900-\u097F\s]+?)\s*(?:ला|कडे|पर्यंत|स|ना|जा|पाहिजे|$)', norm, re.IGNORECASE)
        if m_mr:
            return self._clean_token(m_mr.group(1)), self._clean_token(m_mr.group(2))

        # Pattern 2: "X ते Y" (Marathi / Hindi: Nashik Road ते Panchavati)
        m_te = re.search(r'([a-zA-Z\u0900-\u097F\s]+?)\s+ते\s+([a-zA-Z\u0900-\u097F\s]+)', norm, re.IGNORECASE)
        if m_te:
            return self._clean_token(m_te.group(1)), self._clean_token(m_te.group(2))

        # Pattern 3: Hindi "X से Y तक / को / के लिए"
        m_hi = re.search(r'([a-zA-Z\u0900-\u097F\s]+?)\s+से\s+([a-zA-Z\u0900-\u097F\s]+?)\s*(?:तक|को|के लिए|जाना|$)', norm, re.IGNORECASE)
        if m_hi:
            return self._clean_token(m_hi.group(1)), self._clean_token(m_hi.group(2))

        # Pattern 4: English "from X to Y"
        m_en1 = re.search(r'from\s+([a-zA-Z\s]+?)\s+to\s+([a-zA-Z\s]+)', norm, re.IGNORECASE)
        if m_en1:
            return self._clean_token(m_en1.group(1)), self._clean_token(m_en1.group(2))

        # Pattern 5: English "X to Y"
        m_en2 = re.search(r'([a-zA-Z\s]+?)\s+to\s+([a-zA-Z\s]+)', norm, re.IGNORECASE)
        if m_en2:
            return self._clean_token(m_en2.group(1)), self._clean_token(m_en2.group(2))

        return None


# Global singleton
context_engine = ContextEngine()
