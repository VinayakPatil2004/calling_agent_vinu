"""
CityLinc Multilingual Number & Transit Speech Formatter.
Translates route numbers, timetable hours/minutes, fares, stop counts, and distances
into natural phonetically correct spoken words for Marathi, Hindi, and English.

Examples:
Marathi:
  101 -> एकशे एक
  102 -> एकशे दोन
  151 -> एकशे एकावन्न
  202 -> दोनशे दोन
  300 -> तीनशे
  331 -> तीनशे एकतीस
  08:36 -> आठ वाजून छत्तीस मिनिटांनी
  ₹20 -> वीस रुपये

Hindi:
  101 -> एक सौ एक
  202 -> दो सौ दो
  300 -> तीन सौ
  08:36 -> आठ बजकर छत्तीस मिनट पर
  ₹20 -> बीस रुपये

English:
  101 -> One hundred one
  202 -> Two hundred two
  08:36 -> Eight thirty-six
  ₹20 -> Twenty rupees
"""
import re
from typing import Dict, Optional

