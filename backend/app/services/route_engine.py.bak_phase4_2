"""
CityLinc Origin-Destination Route Engine.
Provides deterministic, high-accuracy transit pathfinding across the audited CityLinc Nashik bus network:
- 315 route records
- 12,909 stop sequence instances
- 1,187 unique physical stations

Features:
- Trilingual place resolution (Marathi, Hindi, English, Devanagari and Roman phonetic scripts)
- Automatic station and directional platform candidate expansion
- Strict topological directionality (ensures boarding stop precedes alighting stop on route)
- Intermediate stop sequence extraction with distances
- Transfer route calculation (1-transfer) via major Nashik transit hubs (CBS, Shalimar, Nimani, Dwarka)
- Route ranking prioritizing scheduled trips, fewest intermediate stops, and direct connectivity
"""
import re
import logging
from typing import Dict, List, Optional, Any, Set, Tuple
from pydantic import BaseModel, Field

from backend.app.services.citylinc_knowledge import knowledge_service, LOCATION_ALIASES, DEVANAGARI_DIGITS
from backend.app.services.location_service import location_service

logger = logging.getLogger("citylinc.route_engine")


# Common suffixes in Marathi and Hindi to strip from place tokens
DEV_AFFIXES = [
    "वरून", "पासून", "पासुन", "हून", "कडून", "कडुन", "ला", "कडे", "पर्यंत", "स", "ना", "चे", "च्या",
    "से", "को", "तक", "के लिए"
]

# Generic transit tokens that must NOT trigger singleton fallback station matching
GENERIC_TRANSIT_TOKENS = {
    "circle", "stand", "stop", "phata", "fata", "road", "corner", "chowk", "chauk",
    "nagar", "depot", "station", "bridge", "point", "gate",
    "सर्कल", "रोड", "स्टॉप", "थांबा", "फाटा", "नाका", "चौक", "नगर", "डेपो", "स्टेशन", "पॉइंट"
}

# Major Transit Interchanges in Nashik for 1-Transfer routing
MAJOR_INTERCHANGES = [
    {
        "hub_name": "CBS (Central Bus Stand)",
        "hub_mr": "सीबीएस (मध्यवर्ती बस स्थानक)",
        "hub_tokens": ["cbs", "सीबीएस", "central bus stand", "मध्यवर्ती"],
        "station_ids": [975, 317, 1590, 1184, 313, 1017]
    },
    {
        "hub_name": "Shalimar",
        "hub_mr": "शालिमार चौक",
        "hub_tokens": ["shalimar", "शालिमार"],
        "station_ids": [1406, 1407, 706, 532, 1099, 1051, 898]
    },
    {
        "hub_name": "Nimani Bus Stand",
        "hub_mr": "निमाणी बस स्थानक",
        "hub_tokens": ["nimani", "निमाणी"],
        "station_ids": [691, 694, 704, 707, 956, 1194]
    },
    {
        "hub_name": "Dwarka Circle",
        "hub_mr": "द्वारका चौक",
        "hub_tokens": ["dwarka", "द्वारका"],
        "station_ids": [497, 1078, 1049, 1050]
    },
    {
        "hub_name": "Panchavati Karanja",
        "hub_mr": "पंचवटी कारंजा",
        "hub_tokens": ["panchavati karanja", "पंचवटी कारंजा"],
        "station_ids": [707, 704, 691, 694]
    },
    {
        "hub_name": "Satpur Bus Stand",
        "hub_mr": "सातपूर बस स्थानक",
        "hub_tokens": ["satpur bus stand", "सातपूर"],
        "station_ids": [410, 929, 753, 916]
    },
    {
        "hub_name": "Nashik Road Depot",
        "hub_mr": "नाशिक रोड डेपो",
        "hub_tokens": ["nashik road depot", "नाशिक रोड"],
        "station_ids": [1440, 250, 281, 277, 863, 1001]
    }
]


class StopInfo(BaseModel):
    station_id: int
    name: str
    display_name: str
    sequence: int
    distance_from_origin_km: float
    lat: float
    lon: float
    direction: str


class DirectRouteOption(BaseModel):
    route_id: int
    rno: str
    route_name: str
    route_type: str
    boarding_stop: StopInfo
    alighting_stop: StopInfo
    intermediate_stops_count: int
    intermediate_stops: List[StopInfo]
    distance_km: float
    timetable_trips_count: int
    scheduled_departures: List[str]
    polyline: List[List[float]]


class TransferLeg(BaseModel):
    leg_number: int
    route_id: int
    rno: str
    route_name: str
    boarding_stop: StopInfo
    alighting_stop: StopInfo
    stops_count: int
    distance_km: float
    timetable_trips_count: int
    scheduled_departures: List[str]


class TransferOption(BaseModel):
    interchange_hub: str
    interchange_hub_mr: str
    transfer_stop_name: str
    leg1: TransferLeg
    leg2: TransferLeg
    total_distance_km: float
    total_stops_count: int


class ResolvedPlace(BaseModel):
    query_text: str
    canonical_name: str
    display_name: str
    matched_station_ids: List[int]
    sample_stops: List[str]
    is_ambiguous: bool


class JourneySearchResult(BaseModel):
    success: bool
    origin: ResolvedPlace
    destination: ResolvedPlace
    direct_routes_count: int
    direct_routes: List[DirectRouteOption]
    transfer_routes_count: int
    transfer_routes: List[TransferOption]
    fare_estimate: Optional[Dict[str, Any]] = None
    clarification_question: Optional[str] = None
    message: str


class TransitRouteEngine:
    """Deterministic Origin-Destination Pathfinding and Transit Journey Engine for CityLinc Nashik."""

    def __init__(self):
        self._build_stop_indices()

    def _build_stop_indices(self):
        """Builds fast inverted indices of station tokens to station IDs and routes."""
        self.station_token_map: Dict[str, Set[int]] = {}
        for sid, st in location_service.stations_by_id.items():
            sname = st["name"].lower()
            clean_name = st["clean_name"].lower()
            # Tokenize words
            tokens = set(re.findall(r'[a-zA-Z0-9\u0900-\u097F]+', sname + " " + clean_name))
            for tok in tokens:
                if len(tok) >= 3:
                    if tok not in self.station_token_map:
                        self.station_token_map[tok] = set()
                    self.station_token_map[tok].add(sid)

    def normalize_text(self, text: str) -> str:
        """Converts Devanagari numerals and trims affixes."""
        out = (text or "").strip()
        for d_char, a_digit in DEVANAGARI_DIGITS.items():
            out = out.replace(d_char, a_digit)
        return out.lower().strip()

    def clean_place_token(self, place_text: str) -> str:
        """Strips Marathi/Hindi grammatical postpositions and whitespace."""
        p = self.normalize_text(place_text)
        # Strip common English prefixes
        for pfx in ["from ", "to ", "at ", "near ", "for "]:
            if p.startswith(pfx):
                p = p[len(pfx):].strip()
        # Strip Devanagari affixes
        for affix in DEV_AFFIXES:
            if p.endswith(affix) and len(p) > len(affix) + 2:
                p = p[:-len(affix)].strip()
                break
        return p.strip()

    def resolve_place(self, place_query: str) -> ResolvedPlace:
        """
        Resolves colloquial place names in Marathi, Hindi, or English to verified station IDs.
        Handles aliases (e.g., 'सीबीएस', 'नासिक रोड', 'गंगापूर', 'तपोवन').
        Prevents generic false matches (such as matching 'police station' when user says 'station').
        """
        clean_q = self.clean_place_token(place_query)
        matched_sids: Set[int] = set()
        canonical_name = clean_q
        display_name = clean_q.title()

        # 1. Check Canonical LOCATION_ALIASES
        # Pass 1: Exact match
        matched_alias_canonical = None
        for canonical, aliases in LOCATION_ALIASES.items():
            for a in aliases:
                if clean_q == a:
                    matched_alias_canonical = canonical
                    break
            if matched_alias_canonical:
                break

        # Pass 2: Substring containment (if no exact match)
        if not matched_alias_canonical:
            for canonical, aliases in LOCATION_ALIASES.items():
                for a in aliases:
                    if a == "station" and clean_q in ("station", "रेल्वे स्टेशन"):
                        matched_alias_canonical = "nashik road"
                        break
                    if clean_q in a or a in clean_q:
                        if len(clean_q) >= 3:
                            matched_alias_canonical = canonical
                            break
                if matched_alias_canonical:
                    break

        if matched_alias_canonical:
            # Special verified mapping for colloquial landmarks without direct eponym stops
            if matched_alias_canonical == "kbt circle" or clean_q in ("kbt circle", "kbt", "k b t circle", "k.b.t. circle", "केबीटी सर्कल", "केबीटी"):
                matched_sids = {122, 1108, 582, 1109}
                canonical_name = "kbt circle"
                display_name = "KBT Circle (Boarding: Thatte Nagar / Vidya Vikas Circle)"
                return ResolvedPlace(
                    query_text=place_query,
                    canonical_name=canonical_name,
                    display_name=display_name,
                    matched_station_ids=sorted(list(matched_sids)),
                    sample_stops=["Thatte Nagar (D)", "Thatte Nagar (U)", "Vidya Vikas Circle (D)", "Vidya Vikas Circle (U)"],
                    is_ambiguous=False
                )

            # Special verified mapping for Nimani Bus Stand (Panchavati Depot / Karanja terminus)
            if matched_alias_canonical == "nimani" or clean_q in ("nimani", "निमाणी", "nimani bus stand", "निमाणी बस स्थानक"):
                matched_sids = {691, 694, 704, 707, 956, 1194}
                canonical_name = "nimani"
                display_name = "Nimani Bus Stand (Panchavati Depot / Karanja)"
                return ResolvedPlace(
                    query_text=place_query,
                    canonical_name=canonical_name,
                    display_name=display_name,
                    matched_station_ids=sorted(list(matched_sids)),
                    sample_stops=["Panchavati Depot Corner (U)", "Panchavati Depot Corner (D)", "Panchavati Karanja 1 (U)", "Panchavati Karanja (D)"],
                    is_ambiguous=False
                )

            canonical_name = matched_alias_canonical
            display_name = matched_alias_canonical.title()
            aliases = LOCATION_ALIASES[matched_alias_canonical]

            exact_phrase_sids: Set[int] = set()
            secondary_sids: Set[int] = set()

            for sid, st in location_service.stations_by_id.items():
                sname = st["name"].lower()
                # Special disambiguation: If user asks for Nashik Road / Railway Station, exclude police stations!
                if matched_alias_canonical == "nashik road" and "police station" in sname:
                    continue

                # Strict prioritization: If user explicitly mentions the canonical or alias token in station name
                if matched_alias_canonical in sname:
                    exact_phrase_sids.add(sid)
                else:
                    for a in aliases:
                        if a == "station":
                            continue  # avoid bare station false positive
                        if a in sname:
                            secondary_sids.add(sid)
                            break

            matched_sids = exact_phrase_sids if exact_phrase_sids else secondary_sids

        # 2. Direct Station Name Match
        if not matched_sids:
            # Exclude lone generic transit tokens from substring match (e.g. 'circle', 'stand')
            if clean_q not in GENERIC_TRANSIT_TOKENS:
                for sid, st in location_service.stations_by_id.items():
                    sname = st["name"].lower()
                    clean_name = st["clean_name"].lower()
                    if clean_q == sname or clean_q == clean_name:
                        matched_sids.add(sid)
                    elif len(clean_q) >= 4 and (clean_q in sname or clean_q in clean_name):
                        matched_sids.add(sid)

        # 3. Fallback to token index (strictly excluding lone generic transit tokens)
        if not matched_sids:
            tokens = re.findall(r'[a-zA-Z0-9\u0900-\u097F]+', clean_q)
            valid_tokens = [tok for tok in tokens if len(tok) >= 4 and tok.lower() not in GENERIC_TRANSIT_TOKENS]
            for tok in valid_tokens:
                if tok in self.station_token_map:
                    matched_sids.update(self.station_token_map[tok])

        sample_stop_names = []
        for sid in list(matched_sids)[:4]:
            if sid in location_service.stations_by_id:
                sample_stop_names.append(location_service.stations_by_id[sid]["name"])

        is_ambig = len(matched_sids) > 15
        return ResolvedPlace(
            query_text=place_query,
            canonical_name=canonical_name,
            display_name=display_name,
            matched_station_ids=sorted(list(matched_sids)),
            sample_stops=sample_stop_names,
            is_ambiguous=is_ambig
        )

    def search_routes(
        self,
        origin_query: str,
        destination_query: str,
        limit_direct: int = 5,
        limit_transfer: int = 3
    ) -> JourneySearchResult:
        """
        Executes complete Origin-Destination pathfinding across all 315 CityLinc routes.
        Returns direct routes ranked by timetable availability and stops count,
        plus 1-transfer routes if required.
        """
        origin_resolved = self.resolve_place(origin_query)
        dest_resolved = self.resolve_place(destination_query)

        if not origin_resolved.matched_station_ids:
            return JourneySearchResult(
                success=False,
                origin=origin_resolved,
                destination=dest_resolved,
                direct_routes_count=0,
                direct_routes=[],
                transfer_routes_count=0,
                transfer_routes=[],
                clarification_question=f"मला '{origin_query}' हा थांबा सापडला नाही. कृपया थांब्याचे नाव पुन्हा सांगा (उदा. CBS, Nashik Road, Panchavati, Satpur).",
                message=f"Origin '{origin_query}' could not be resolved to any CityLinc bus stop."
            )

        if not dest_resolved.matched_station_ids:
            return JourneySearchResult(
                success=False,
                origin=origin_resolved,
                destination=dest_resolved,
                direct_routes_count=0,
                direct_routes=[],
                transfer_routes_count=0,
                transfer_routes=[],
                clarification_question=f"मला '{destination_query}' हे ठिकाण सापडले नाही. कृपया योग्य गंतव्य सांगा.",
                message=f"Destination '{destination_query}' could not be resolved to any CityLinc bus stop."
            )

        origin_sids = set(origin_resolved.matched_station_ids)
        dest_sids = set(dest_resolved.matched_station_ids)

        direct_options: List[DirectRouteOption] = []

        # -------------------------------------------------------------
        # 1. Search Direct Routes across all 315 master routes
        # -------------------------------------------------------------
        for r in knowledge_service.routes:
            rid = r.get("routeid")
            rno = str(r.get("rno", "")).strip().upper()
            rname = r.get("routename") or r.get("displayfullroutename") or ""
            rtype = r.get("routetype") or "Standard"
            stops = r.get("stops", [])

            if not stops:
                continue

            origin_idx = -1
            dest_idx = -1

            # Find earliest origin stop and earliest destination stop after origin
            for idx, s in enumerate(stops):
                sid = s.get("stationid")
                if sid is not None:
                    sid = int(sid)
                    if origin_idx == -1 and sid in origin_sids:
                        origin_idx = idx
                    elif origin_idx != -1 and sid in dest_sids:
                        dest_idx = idx
                        break

            # Verify forward topological order
            if origin_idx != -1 and dest_idx != -1 and origin_idx < dest_idx:
                raw_b = stops[origin_idx]
                raw_a = stops[dest_idx]

                try:
                    b_dist = float(raw_b.get("totaldistance") or 0.0)
                    a_dist = float(raw_a.get("totaldistance") or 0.0)
                    journey_dist = round(max(0.1, a_dist - b_dist), 2)
                except (ValueError, TypeError):
                    journey_dist = 0.0

                # Build Boarding & Alighting models
                b_stop = StopInfo(
                    station_id=int(raw_b.get("stationid")),
                    name=raw_b.get("stationname") or "",
                    display_name=raw_b.get("displayname") or raw_b.get("stationname") or "",
                    sequence=int(raw_b.get("srno") or (origin_idx + 1)),
                    distance_from_origin_km=b_dist,
                    lat=float(raw_b.get("center_lat") or 0.0),
                    lon=float(raw_b.get("center_lon") or 0.0),
                    direction=location_service._determine_direction(raw_b.get("stationname") or "")
                )

                a_stop = StopInfo(
                    station_id=int(raw_a.get("stationid")),
                    name=raw_a.get("stationname") or "",
                    display_name=raw_a.get("displayname") or raw_a.get("stationname") or "",
                    sequence=int(raw_a.get("srno") or (dest_idx + 1)),
                    distance_from_origin_km=a_dist,
                    lat=float(raw_a.get("center_lat") or 0.0),
                    lon=float(raw_a.get("center_lon") or 0.0),
                    direction=location_service._determine_direction(raw_a.get("stationname") or "")
                )

                # Intermediate stops
                inter_stops = []
                polyline_coords = []
                for s in stops[origin_idx: dest_idx + 1]:
                    try:
                        slat = float(s.get("center_lat") or 0.0)
                        slon = float(s.get("center_lon") or 0.0)
                        sdist = float(s.get("totaldistance") or 0.0)
                    except (ValueError, TypeError):
                        slat, slon, sdist = 0.0, 0.0, 0.0

                    if slat != 0.0 and slon != 0.0:
                        # Deduplicate adjacent identical coordinates
                        if not polyline_coords or polyline_coords[-1] != [slat, slon]:
                            polyline_coords.append([slat, slon])

                    inter_stops.append(StopInfo(
                        station_id=int(s.get("stationid")),
                        name=s.get("stationname") or "",
                        display_name=s.get("displayname") or s.get("stationname") or "",
                        sequence=int(s.get("srno") or 0),
                        distance_from_origin_km=sdist,
                        lat=slat,
                        lon=slon,
                        direction=location_service._determine_direction(s.get("stationname") or "")
                    ))

                trips = r.get("timetable", [])
                departures = [t.get("eta") for t in trips if t.get("eta")][:5]

                direct_options.append(DirectRouteOption(
                    route_id=int(rid),
                    rno=rno,
                    route_name=rname,
                    route_type=rtype,
                    boarding_stop=b_stop,
                    alighting_stop=a_stop,
                    intermediate_stops_count=dest_idx - origin_idx,
                    intermediate_stops=inter_stops,
                    distance_km=journey_dist,
                    timetable_trips_count=len(trips),
                    scheduled_departures=departures,
                    polyline=polyline_coords
                ))

        # Sort direct routes:
        # Prioritize routes that have active timetable trips, then fewest intermediate stops, then distance
        direct_options.sort(key=lambda x: (
            x.timetable_trips_count == 0,
            x.intermediate_stops_count,
            x.distance_km
        ))

        # Deduplicate direct routes by public route number (rno) for clean presentation
        pruned_direct: List[DirectRouteOption] = []
        seen_rnos = set()
        for dr in direct_options:
            if dr.rno not in seen_rnos:
                seen_rnos.add(dr.rno)
                pruned_direct.append(dr)
                if len(pruned_direct) >= limit_direct:
                    break

        # -------------------------------------------------------------
        # 2. Search 1-Transfer Routes (if direct routes count is low)
        # -------------------------------------------------------------
        transfer_options: List[TransferOption] = []

        if len(pruned_direct) < 2:
            for hub in MAJOR_INTERCHANGES:
                hub_sids = set(hub["station_ids"])
                # Avoid using origin or destination as the interchange hub
                if origin_sids.intersection(hub_sids) or dest_sids.intersection(hub_sids):
                    continue

                best_leg1 = None
                best_leg2 = None

                # Find Leg 1: Origin -> Hub
                for r in knowledge_service.routes:
                    stops = r.get("stops", [])
                    o_idx = next((i for i, s in enumerate(stops) if int(s.get("stationid") or -1) in origin_sids), -1)
                    h_idx = next((i for i, s in enumerate(stops) if int(s.get("stationid") or -1) in hub_sids), -1)

                    if o_idx != -1 and h_idx != -1 and o_idx < h_idx:
                        trips = r.get("timetable", [])
                        dist = float(stops[h_idx].get("totaldistance") or 0) - float(stops[o_idx].get("totaldistance") or 0)
                        leg1 = TransferLeg(
                            leg_number=1,
                            route_id=int(r.get("routeid")),
                            rno=str(r.get("rno", "")),
                            route_name=r.get("routename") or "",
                            boarding_stop=StopInfo(
                                station_id=int(stops[o_idx]["stationid"]),
                                name=stops[o_idx]["stationname"],
                                display_name=stops[o_idx].get("displayname") or stops[o_idx]["stationname"],
                                sequence=int(stops[o_idx].get("srno") or o_idx + 1),
                                distance_from_origin_km=float(stops[o_idx].get("totaldistance") or 0),
                                lat=float(stops[o_idx].get("center_lat") or 0),
                                lon=float(stops[o_idx].get("center_lon") or 0),
                                direction=location_service._determine_direction(stops[o_idx]["stationname"])
                            ),
                            alighting_stop=StopInfo(
                                station_id=int(stops[h_idx]["stationid"]),
                                name=stops[h_idx]["stationname"],
                                display_name=stops[h_idx].get("displayname") or stops[h_idx]["stationname"],
                                sequence=int(stops[h_idx].get("srno") or h_idx + 1),
                                distance_from_origin_km=float(stops[h_idx].get("totaldistance") or 0),
                                lat=float(stops[h_idx].get("center_lat") or 0),
                                lon=float(stops[h_idx].get("center_lon") or 0),
                                direction=location_service._determine_direction(stops[h_idx]["stationname"])
                            ),
                            stops_count=h_idx - o_idx,
                            distance_km=round(max(0.1, dist), 2),
                            timetable_trips_count=len(trips),
                            scheduled_departures=[t.get("eta") for t in trips if t.get("eta")][:3]
                        )
                        if best_leg1 is None or (leg1.timetable_trips_count > 0 and best_leg1.timetable_trips_count == 0) or leg1.stops_count < best_leg1.stops_count:
                            best_leg1 = leg1

                # Find Leg 2: Hub -> Destination
                for r in knowledge_service.routes:
                    stops = r.get("stops", [])
                    h_idx = next((i for i, s in enumerate(stops) if int(s.get("stationid") or -1) in hub_sids), -1)
                    d_idx = next((i for i, s in enumerate(stops) if int(s.get("stationid") or -1) in dest_sids), -1)

                    if h_idx != -1 and d_idx != -1 and h_idx < d_idx:
                        trips = r.get("timetable", [])
                        dist = float(stops[d_idx].get("totaldistance") or 0) - float(stops[h_idx].get("totaldistance") or 0)
                        leg2 = TransferLeg(
                            leg_number=2,
                            route_id=int(r.get("routeid")),
                            rno=str(r.get("rno", "")),
                            route_name=r.get("routename") or "",
                            boarding_stop=StopInfo(
                                station_id=int(stops[h_idx]["stationid"]),
                                name=stops[h_idx]["stationname"],
                                display_name=stops[h_idx].get("displayname") or stops[h_idx]["stationname"],
                                sequence=int(stops[h_idx].get("srno") or h_idx + 1),
                                distance_from_origin_km=float(stops[h_idx].get("totaldistance") or 0),
                                lat=float(stops[h_idx].get("center_lat") or 0),
                                lon=float(stops[h_idx].get("center_lon") or 0),
                                direction=location_service._determine_direction(stops[h_idx]["stationname"])
                            ),
                            alighting_stop=StopInfo(
                                station_id=int(stops[d_idx]["stationid"]),
                                name=stops[d_idx]["stationname"],
                                display_name=stops[d_idx].get("displayname") or stops[d_idx]["stationname"],
                                sequence=int(stops[d_idx].get("srno") or d_idx + 1),
                                distance_from_origin_km=float(stops[d_idx].get("totaldistance") or 0),
                                lat=float(stops[d_idx].get("center_lat") or 0),
                                lon=float(stops[d_idx].get("center_lon") or 0),
                                direction=location_service._determine_direction(stops[d_idx]["stationname"])
                            ),
                            stops_count=d_idx - h_idx,
                            distance_km=round(max(0.1, dist), 2),
                            timetable_trips_count=len(trips),
                            scheduled_departures=[t.get("eta") for t in trips if t.get("eta")][:3]
                        )
                        if best_leg2 is None or (leg2.timetable_trips_count > 0 and best_leg2.timetable_trips_count == 0) or leg2.stops_count < best_leg2.stops_count:
                            best_leg2 = leg2

                if best_leg1 and best_leg2:
                    transfer_options.append(TransferOption(
                        interchange_hub=hub["hub_name"],
                        interchange_hub_mr=hub["hub_mr"],
                        transfer_stop_name=best_leg1.alighting_stop.name,
                        leg1=best_leg1,
                        leg2=best_leg2,
                        total_distance_km=round(best_leg1.distance_km + best_leg2.distance_km, 2),
                        total_stops_count=best_leg1.stops_count + best_leg2.stops_count
                    ))

            transfer_options.sort(key=lambda x: (x.total_stops_count, x.total_distance_km))
            transfer_options = transfer_options[:limit_transfer]

        # Fare calculation
        fare_estimate = None
        if pruned_direct:
            top_dist = pruned_direct[0].distance_km
            fare_amt = knowledge_service.get_fare(top_dist) if hasattr(knowledge_service, "get_fare") else None
            if not fare_amt:
                # Default standard Nashik slab: <=2km: ₹10, 2-6km: ₹15, 6-10km: ₹20, 10-14km: ₹25, >14km: ₹30
                if top_dist <= 2.5:
                    fare_amt = 10
                elif top_dist <= 6.0:
                    fare_amt = 15
                elif top_dist <= 10.0:
                    fare_amt = 20
                elif top_dist <= 15.0:
                    fare_amt = 25
                else:
                    fare_amt = 30
            fare_estimate = {
                "distance_km": top_dist,
                "single_fare_inr": fare_amt,
                "pass_category": "Standard Municipal Tariff Slab"
            }

        msg = f"Found {len(pruned_direct)} direct routes"
        if transfer_options:
            msg += f" and {len(transfer_options)} transfer options"
        msg += f" between {origin_resolved.display_name} and {dest_resolved.display_name}."

        return JourneySearchResult(
            success=bool(pruned_direct or transfer_options),
            origin=origin_resolved,
            destination=dest_resolved,
            direct_routes_count=len(pruned_direct),
            direct_routes=pruned_direct,
            transfer_routes_count=len(transfer_options),
            transfer_routes=transfer_options,
            fare_estimate=fare_estimate,
            message=msg
        )


# Global singleton
route_engine = TransitRouteEngine()
