/* CityLinc Multilingual Voice Agent Stylesheet */
:root {
  --bg-primary: #0b0f19;
  --bg-card: #151d2e;
  --bg-card-subtle: #1c263c;
  --border-color: #273552;
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --primary: #3b82f6;
  --primary-glow: rgba(59, 130, 246, 0.4);
  --success: #10b981;
  --success-glow: rgba(16, 185, 129, 0.4);
  --warning: #f59e0b;
  --danger: #ef4444;
  --purple: #8b5cf6;
  --purple-glow: rgba(139, 92, 246, 0.4);
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-sm: 6px;
  --font-family: 'Inter', 'Noto Sans Devanagari', -apple-system, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  background-color: var(--bg-primary);
  color: var(--text-main);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.app-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  max-width: 1300px;
  margin: 0 auto;
  width: 100%;
  padding: 16px 20px;
}

/* Header */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 12px;
}

.logo-group {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-icon {
  font-size: 32px;
  background: rgba(59, 130, 246, 0.15);
  padding: 8px 12px;
  border-radius: var(--radius-md);
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.app-header h1 {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.3px;
}

.subtitle {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 2px;
}

.header-badges {
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 20px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.badge-online {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.badge-offline {
  background: rgba(239, 68, 68, 0.15);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.badge-neutral {
  background: rgba(148, 163, 184, 0.15);
  color: #cbd5e1;
  border: 1px solid rgba(148, 163, 184, 0.3);
}

/* Main Layout */
.main-content {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 20px;
  flex: 1;
}

@media (max-width: 900px) {
  .main-content {
    grid-template-columns: 1fr;
  }
}

/* Cards */
.voice-card, .transcript-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
}

/* Voice Orb Section */
.voice-orb-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20px 0 16px 0;
  height: 180px;
}

.voice-orb {
  position: relative;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.4s ease;
  z-index: 2;
}

.orb-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1e293b, #0f172a);
  border: 2px solid var(--border-color);
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  z-index: 3;
}

.orb-icon {
  font-size: 40px;
  transition: transform 0.2s;
}

/* Pulsing rings */
.pulse-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

/* Orb States */
.voice-orb.idle .orb-core {
  border-color: #334155;
}

.voice-orb.listening {
  transform: scale(1.05);
}
.voice-orb.listening .orb-core {
  border-color: var(--primary);
  box-shadow: 0 0 30px var(--primary-glow);
}
.voice-orb.listening .pulse-ring {
  border: 2px solid var(--primary);
  animation: pulse 2s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
}
.voice-orb.listening .ring-1 { width: 140px; height: 140px; animation-delay: 0s; }
.voice-orb.listening .ring-2 { width: 170px; height: 170px; animation-delay: 0.6s; }
.voice-orb.listening .ring-3 { width: 200px; height: 200px; animation-delay: 1.2s; }

.voice-orb.thinking .orb-core {
  border-color: var(--warning);
  box-shadow: 0 0 30px rgba(245, 158, 11, 0.4);
  animation: spinSlow 3s linear infinite;
}

.voice-orb.speaking {
  transform: scale(1.08);
}
.voice-orb.speaking .orb-core {
  border-color: var(--purple);
  box-shadow: 0 0 35px var(--purple-glow);
}
.voice-orb.speaking .pulse-ring {
  border: 2px solid var(--purple);
  animation: pulse 1.6s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
}
.voice-orb.speaking .ring-1 { width: 140px; height: 140px; animation-delay: 0s; }
.voice-orb.speaking .ring-2 { width: 180px; height: 180px; animation-delay: 0.5s; }
.voice-orb.speaking .ring-3 { width: 220px; height: 220px; animation-delay: 1.0s; }

.voice-orb.interrupted .orb-core {
  border-color: var(--danger);
  box-shadow: 0 0 25px rgba(239, 68, 68, 0.5);
}

@keyframes pulse {
  0% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(1.4); opacity: 0; }
}

@keyframes spinSlow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Status Text */
.agent-status-container {
  text-align: center;
  margin-bottom: 12px;
}

.agent-status-container h2 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 4px;
}

.agent-status-container p {
  font-size: 13px;
  color: var(--text-muted);
}

/* Canvas */
#visualizer-canvas {
  width: 100%;
  height: 48px;
  background: rgba(0, 0, 0, 0.25);
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Buttons */
.voice-controls {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: var(--radius-md);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
  font-family: inherit;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  flex: 2;
}
.btn-primary:hover:not(:disabled) {
  background: #2563eb;
  box-shadow: 0 4px 14px var(--primary-glow);
}

.btn-danger {
  background: #dc2626;
  color: #fff;
  flex: 2;
}
.btn-danger:hover:not(:disabled) {
  background: #b91c1c;
}

.btn-warning {
  background: #d97706;
  color: #fff;
  flex: 1;
}
.btn-warning:hover:not(:disabled) {
  background: #b45309;
}

.btn-subtle {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border-color);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  cursor: pointer;
}
.btn-subtle:hover {
  color: #fff;
  border-color: #475569;
}

/* Settings strip */
.settings-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  background: var(--bg-card-subtle);
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  margin-bottom: 16px;
  gap: 8px;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}

.form-select {
  background: #0f172a;
  color: #fff;
  border: 1px solid #334155;
  border-radius: var(--radius-sm);
  padding: 4px 8px;
  font-size: 12px;
  font-family: inherit;
  outline: none;
}

.btn-action {
  background: #059669;
  color: #fff;
  flex: 2;
}
.btn-action:hover:not(:disabled) {
  background: #047857;
}

.btn-action.recording {
  background: #dc2626;
  animation: pulseButton 1s infinite alternate;
}

@keyframes pulseButton {
  from { box-shadow: 0 0 5px rgba(220, 38, 38, 0.5); }
  to { box-shadow: 0 0 18px rgba(220, 38, 38, 0.9); }
}

/* Microphone Diagnostics Card */
.mic-diagnostics-card {
  background: #0d1424;
  border: 1px solid #1e293b;
  border-radius: var(--radius-md);
  padding: 12px;
  font-size: 12px;
  margin-bottom: 14px;
}

.mic-diag-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.mic-diag-title {
  font-weight: 600;
  color: #94a3b8;
}

.mic-diag-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.diag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.diag-label {
  color: #94a3b8;
  font-weight: 500;
  width: 90px;
  flex-shrink: 0;
}

.diag-val {
  color: #f1f5f9;
  font-family: monospace;
  font-size: 11px;
  word-break: break-all;
}

.meter-wrapper {
  flex: 1;
  height: 8px;
  background: #1e293b;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

.meter-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #3b82f6 70%, #ef4444 100%);
  width: 0%;
  transition: width 0.05s ease;
  border-radius: 4px;
}

.mic-error-box {
  margin-top: 8px;
  padding: 6px 10px;
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.4);
  color: #fca5a5;
  border-radius: var(--radius-sm);
  font-size: 11px;
  line-height: 1.4;
}

.pill-neutral { background: rgba(148, 163, 184, 0.15); color: #cbd5e1; }
.pill-active { background: rgba(16, 185, 129, 0.25); color: #34d399; font-weight: 600; }
.pill-busy { background: rgba(59, 130, 246, 0.25); color: #60a5fa; font-weight: 600; }
.pill-danger { background: rgba(239, 68, 68, 0.25); color: #f87171; font-weight: 600; }

.barge-in-badge {
  font-size: 11px;
  color: #38bdf8;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: rgba(56, 189, 248, 0.1);
  padding: 3px 8px;
  border-radius: 12px;
  border: 1px solid rgba(56, 189, 248, 0.25);
}

.barge-in-badge .dot {
  width: 6px;
  height: 6px;
  background: #38bdf8;
  border-radius: 50%;
  box-shadow: 0 0 6px #38bdf8;
}

/* Diagnostics card */
.diagnostics-card {
  margin-top: auto;
  background: #0d1322;
  border: 1px solid #1e293b;
  border-radius: var(--radius-md);
  padding: 12px;
  font-size: 12px;
}

.diag-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  color: var(--text-muted);
  font-weight: 600;
}

.diag-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  color: #cbd5e1;
}

.badge-text {
  color: #38bdf8;
  font-weight: 600;
}

.pill {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
}
.pill-success { background: rgba(16, 185, 129, 0.2); color: #34d399; }
.pill-warning { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }

/* Transcript Card */
.transcript-card {
  position: relative;
}

.transcript-header {
  margin-bottom: 12px;
}

.header-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.header-title-row h3 {
  font-size: 16px;
  font-weight: 600;
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 6px;
}

.prompt-chip {
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  font-size: 12px;
  color: #cbd5e1;
  padding: 4px 10px;
  border-radius: 14px;
  cursor: pointer;
  transition: all 0.2s;
}
.prompt-chip:hover {
  background: #334155;
  color: #fff;
  border-color: #64748b;
}

/* Transcript Feed */
.transcript-feed {
  flex: 1;
  overflow-y: auto;
  max-height: 480px;
  min-height: 380px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 10px 4px;
  margin-bottom: 16px;
  scroll-behavior: smooth;
}

/* Custom scrollbar */
.transcript-feed::-webkit-scrollbar {
  width: 6px;
}
.transcript-feed::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 3px;
}

.welcome-bubble {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: rgba(59, 130, 246, 0.08);
  border: 1px dashed rgba(59, 130, 246, 0.3);
  border-radius: var(--radius-md);
  padding: 16px;
}

.welcome-icon {
  font-size: 26px;
}

.welcome-text h4 {
  font-size: 14px;
  color: #93c5fd;
  margin-bottom: 4px;
}

.welcome-text p {
  font-size: 13px;
  color: #cbd5e1;
  line-height: 1.5;
}

/* Message bubbles */
.msg-bubble {
  display: flex;
  flex-direction: column;
  max-width: 82%;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-size: 14px;
  line-height: 1.5;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-user {
  align-self: flex-end;
  background: #1e3a8a;
  border: 1px solid #2563eb;
  color: #fff;
  border-bottom-right-radius: 2px;
}

.msg-assistant {
  align-self: flex-start;
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  color: #f1f5f9;
  border-bottom-left-radius: 2px;
}

.msg-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
  font-size: 11px;
  color: var(--text-muted);
}

.msg-sender {
  font-weight: 600;
}

.msg-lang {
  background: rgba(255, 255, 255, 0.1);
  padding: 1px 6px;
  border-radius: 8px;
  font-size: 10px;
}

.msg-content {
  word-break: break-word;
}

/* Chat Input Bar */
.chat-input-bar {
  display: flex;
  gap: 8px;
}

.chat-input-bar input {
  flex: 1;
  background: #0f172a;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  color: #fff;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s;
}

.chat-input-bar input:focus {
  border-color: var(--primary);
}

.btn-send {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  width: 44px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.btn-send:hover {
  background: #2563eb;
}

/* Footer */
.app-footer {
  text-align: center;
  padding: 14px 0 0 0;
  font-size: 12px;
  color: #64748b;
}

