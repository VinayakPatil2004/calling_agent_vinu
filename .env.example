# ==============================================================================
# CityLinc Multilingual Voice Agent - Environment Variables Example
# ==============================================================================

# Sarvam AI API Key (Get from https://sarvam.ai)
# Powers Saaras v4 STT (Speech-to-Text) and Bulbul v3 TTS (Text-to-Speech)
SARVAM_API_KEY="your-sarvam-api-key-here"

# Sarvam Configuration
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_STT_MODEL="saaras:v4"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="shubh"

# Optional Alternative LLMs (System defaults to CityLinc Knowledge Engine & Sarvam LLM)
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Multilingual Settings (Supported: mr-IN, hi-IN, en-IN)
DEFAULT_LANGUAGE="mr-IN"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

